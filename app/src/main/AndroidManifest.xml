<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11 需要 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name="top.niunaijun.blackbox.app.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlackBox">
        <activity android:name="top.niunaijun.blackbox.view.setting.SettingActivity" />
        <activity android:name="top.niunaijun.blackbox.view.gms.GmsManagerActivity" />
        <activity
            android:name="top.niunaijun.blackbox.view.main.WelcomeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/WelcomeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="top.niunaijun.blackbox.view.list.ListActivity" />
        <activity android:name="top.niunaijun.blackbox.view.xp.XpActivity" />
        <activity android:name="top.niunaijun.blackbox.view.libchook.LibcHookActivity" />
        <activity android:name="top.niunaijun.blackbox.view.mapshide.MapsHideActivity" />
        <activity android:name="top.niunaijun.blackbox.view.soinject.SoInjectActivity" />
        <activity android:name="top.niunaijun.blackbox.view.devicespoof.DeviceSpoofActivity" />
        <activity
            android:name="top.niunaijun.blackbox.view.main.ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true" />
        <activity
            android:name="top.niunaijun.blackbox.view.main.MainActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
    </application>

</manifest>