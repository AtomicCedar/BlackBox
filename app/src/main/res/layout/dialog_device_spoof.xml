<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/device_spoof_enable"
                android:textColor="@color/primary_text"
                android:textSize="15sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/enable_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/random_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_app_config_panel"
                android:gravity="center"
                android:padding="11dp"
                android:text="@string/device_spoof_random"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />

        <TextView
                android:id="@+id/clear_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_app_config_panel"
                android:gravity="center"
                android:padding="11dp"
                android:text="@string/device_spoof_clear"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />
    </LinearLayout>

    <TextView
            android:id="@+id/brand_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_app_config_panel"
            android:gravity="center_vertical"
            android:padding="11dp"
            android:textColor="@color/primary_text"
            android:textSize="14sp" />

    <TextView
            android:id="@+id/model_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_app_config_panel"
            android:gravity="center_vertical"
            android:padding="11dp"
            android:textColor="@color/primary_text"
            android:textSize="14sp" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/device_spoof_section_device"
            android:textColor="@color/primary_text"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_manufacturer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_manufacturer"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_model"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_market_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_market_name"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_product"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_device"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_board"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_fingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_fingerprint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_radio_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_radio_version"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

        <EditText
                android:id="@+id/field_sdk_int"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_maps_hide_input"
                android:hint="@string/device_spoof_sdk_int"
                android:importantForAutofill="no"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="@color/primary_text"
                android:textColorHint="#BDBDBD"
                android:textSize="13sp" />

        <EditText
                android:id="@+id/field_release"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_maps_hide_input"
                android:hint="@string/device_spoof_release"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:padding="12dp"
                android:textColor="@color/primary_text"
                android:textColorHint="#BDBDBD"
                android:textSize="13sp" />
    </LinearLayout>

    <EditText
            android:id="@+id/field_build_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_build_id"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_characteristics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_characteristics"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/device_spoof_section_sim"
            android:textColor="@color/primary_text"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_sim_operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_sim_operator_hint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_sim_operator_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_sim_operator_name"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_sim_country_iso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_sim_country_iso"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/device_spoof_section_id"
            android:textColor="@color/primary_text"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_device_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_device_id"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_imei"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_imei"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

    <EditText
            android:id="@+id/field_phone_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_maps_hide_input"
            android:hint="@string/device_spoof_phone_number"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:padding="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />

</LinearLayout>
